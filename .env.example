# ============================================================================
# DÉVELOPPEMENT UNIQUEMENT — à RETIRER du .env de production
# ============================================================================
# Le proxy (nginx) achemine par nom de domaine en prod : aucun port n'est publié.
FRONTEND_PORT=3000
BACKEND_PORT=5000
DB_PORT=3306
# URL de l'API vue par le navigateur (buildée dans l'image en prod : dépend du domaine)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ============================================================================
# PRODUCTION (et développement)
# ============================================================================
MYSQL_ROOT_PASSWORD=ChangeMe-Root
MYSQL_DATABASE=inventory_it
MYSQL_USER=inventory-it
MYSQL_PASSWORD=ChangeMe-User

# Secret JWT : générer une longue chaîne aléatoire
JWT_SECRET=ChangeMe-With-A-Long-Random-Secret

# Public URL du frontend (liens dans les e-mails)
FRONTEND_URL=http://localhost:3000

# SMTP (envoi d'e-mails : création de comptes / mot de passe temporaire)
# Optionnel : si SMTP_HOST est vide, le mot de passe temporaire est renvoyé dans l'API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=